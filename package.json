    "start": "node dist/cli.js",
    "test": "node --test \"test/**/*.test.ts\"",
    "mock-llm": "node fixtures/mock-llm/server.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.1.0"
  }
}
